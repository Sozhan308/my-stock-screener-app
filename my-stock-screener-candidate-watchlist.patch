--- a/frontend/src/styles.css
+++ b/frontend/src/styles.css
@@ -397,3 +397,134 @@
 @keyframes spin {
   to { transform: rotate(360deg); }
 }
+
+/* Candidate detail + watchlist additions */
+.table-title-row {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 16px;
+}
+
+.view-tabs {
+  display: flex;
+  gap: 4px;
+  padding: 3px;
+  border: 1px solid #29313b;
+  border-radius: 8px;
+  background: #0f141b;
+}
+
+.view-tabs button {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  border: 0;
+  border-radius: 6px;
+  padding: 7px 10px;
+  color: #7d8996;
+  background: transparent;
+  cursor: pointer;
+}
+
+.view-tabs button.active {
+  color: #fff;
+  background: #263241;
+}
+
+.modal-actions {
+  display: flex;
+  gap: 7px;
+}
+
+.icon-button {
+  width: 34px;
+  height: 34px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border: 1px solid #29313b;
+  border-radius: 8px;
+  color: #9aa5b1;
+  background: #121821;
+  cursor: pointer;
+}
+
+.icon-button.starred {
+  color: #e3b341;
+}
+
+.modal-subtitle {
+  display: block;
+  margin-top: 3px;
+  color: #7d8996;
+  font-size: 12px;
+}
+
+.structure-grid {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 7px;
+  margin-bottom: 16px;
+}
+
+.structure-grid div {
+  padding: 10px 11px;
+  border: 1px solid #29313b;
+  border-radius: 8px;
+  background: #0e141b;
+}
+
+.structure-grid span {
+  display: block;
+  color: #7d8996;
+  font-size: 10px;
+}
+
+.structure-grid strong {
+  display: block;
+  margin-top: 3px;
+  font-size: 13px;
+}
+
+.setup-note {
+  display: grid;
+  gap: 3px;
+  margin-bottom: 16px;
+  padding: 12px;
+  border: 1px solid #29313b;
+  border-radius: 8px;
+  background: #101821;
+}
+
+.setup-note strong {
+  font-size: 14px;
+}
+
+.setup-note span {
+  color: #7d8996;
+  font-size: 11px;
+}
+
+.modal-footer {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 8px;
+}
+
+.watch-button {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  padding: 11px;
+  border: 1px solid #29313b;
+  border-radius: 8px;
+  color: #d8dee6;
+  background: #121821;
+  cursor: pointer;
+}
+
+.watch-button:hover {
+  background: #19212c;
+}
